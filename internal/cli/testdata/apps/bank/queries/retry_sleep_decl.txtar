$GOROOT/src/context/context.go:*: unresolved(memory): value of TypeAssert not modelled
	wrap chain (origin → target):
		$WORK/retry/retry.go:63:10-57: fmt.Errorf "retry: interrupted: %w"
	path (origin → target):
		$GOROOT/src/context/context.go:*: in (*context.cancelCtx).Err
		$WORK/retry/retry.go:63:47-56: in example.com/bank/retry.sleep, call to (*context.cancelCtx).Err (dynamic (context.Context).Err: 1 of 1 candidates)
