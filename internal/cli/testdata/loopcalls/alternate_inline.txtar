The inline equivalent of alternate.txtar.
-- args --
a.go:@q
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrB = errors.New("b")

func /*@q*/Q(n int) error {
	err := ErrB
	for i := 0; i < n; i++ {
		if i%2 == 0 {
			err = fmt.Errorf("p1: %w", err)
		} else {
			err = fmt.Errorf("p2: %w", err)
		}
	}
	return err
}
