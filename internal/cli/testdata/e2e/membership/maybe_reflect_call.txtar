3
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"reflect"
)

var ErrX = errors.New("x")

func give() error { return ErrX }

func /*@f*/F() error { return reflect.ValueOf(give).Call(nil)[0].Interface().(error) }

func main() { _ = F() }
