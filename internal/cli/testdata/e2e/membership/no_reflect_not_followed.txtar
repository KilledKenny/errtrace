A store through reflection whose destination the upward pass cannot tell (the Value comes out of a variable) is not followed: the Verdict stays no, and names the store.
-- args --
-is example.com/fx.ErrX a.go:@f
-- stdout --
$WORK/a.go:16:12-15: example.com/fx.ErrX in Error Set of example.com/fx.Get: no
	not followed: example.com/fx.ErrX reaches 1 reflective store whose destination is unknown:
		$WORK/a.go:14:16-47: in example.com/fx.store
-- exit --
1
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"reflect"
)

var ErrX = errors.New("x")

var slot error
var dest = reflect.ValueOf(&slot).Elem()

func store() { dest.Set(reflect.ValueOf(ErrX)) }

func /*@f*/Get() error { return slot }

func main() {
	store()
	fmt.Println(Get())
}
