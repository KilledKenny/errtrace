-- go.mod --
module example.com/fx

go 1.24
-- lib/lib.go --
package lib

import "errors"

var ErrNotFound = errors.New("not found")

type Store interface{ Get(k string) (string, error) }

func /*@f*/Lookup(s Store, k string) error {
	_, err := s.Get(k)
	return err
}
-- cmd/app/main.go --
package main

func main() {}
