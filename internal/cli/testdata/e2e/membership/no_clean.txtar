package fx

import (
	"errors"
	"fmt"
	"io"
)

var ErrOther = errors.New("other")

func /*@f*/F(n int) error {
	if n == 0 {
		return fmt.Errorf("f: %v", io.EOF)
	}
	return ErrOther
}
