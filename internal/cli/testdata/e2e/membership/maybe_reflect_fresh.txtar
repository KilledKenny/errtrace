-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"reflect"
)

var ErrX = errors.New("x")

func newValue(t reflect.Type) reflect.Value { return reflect.New(t).Elem() }

func /*@f*/Get() error {
	v := newValue(reflect.TypeOf((*error)(nil)).Elem())
	v.Set(reflect.ValueOf(ErrX))
	return v.Interface().(error)
}

func main() { fmt.Println(Get()) }
