-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"reflect"
)

type CodeErr struct{ n int }

func (CodeErr) Error() string { return "code" }

var slot any
var dest = reflect.ValueOf(&slot).Elem()
var types = []reflect.Type{reflect.TypeOf(CodeErr{})}

func store() { dest.Set(reflect.New(types[0]).Elem()) }

func /*@f*/Get() error {
	e, _ := slot.(error)
	return e
}

func /*@g*/Other() error { return errors.New("other") }

func main() {
	store()
	fmt.Println(Get(), Other())
}
