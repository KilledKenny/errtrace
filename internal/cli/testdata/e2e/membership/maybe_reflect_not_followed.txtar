package main

import (
	"errors"
	"fmt"
	"reflect"
)

var ErrX = errors.New("x")

type box struct{ err error }

var b = &box{}

var slot error
var dest = reflect.ValueOf(&slot).Elem()

func store() {
	b.err = ErrX
	dest.Set(reflect.ValueOf(ErrX))
}

func /*@f*/Get() error {
	if b.err != nil {
		return b.err
	}
	return slot
}

func main() {
	store()
	fmt.Println(Get())
}
