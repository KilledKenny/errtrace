package main

import "errors"

type Inner struct{ n int }

func (i *Inner) Error() string { return "i" }
func (i *Inner) Self() error   { return i }

type selfer interface{ Self() error }
type outer struct{ *Inner }

var ErrI error = &Inner{1}

func mk() selfer { return outer{ErrI.(*Inner)} }

func /*@f*/F() error { return mk().Self() }

func main() { _ = errors.Is(F(), ErrI) }
