module example.com/fx

go 1.24
-- a.go --
package fx

import "errors"

var ErrX = errors.New("x")

type S struct {
	err  error
	last error
}

func (s *S) Fail() { s.err = ErrX }

func /*@f*/F(s *S) error {
	if s.last != nil {
		return s.last
	}
	return s.err
}
