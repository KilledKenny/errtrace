3
-- go.mod --
module example.com/fx

go 1.24
-- internal/store/store.go --
package store

// Hook is set by whoever imports the package.
var Hook func() error

func /*@f*/Run() error {
	if Hook == nil {
		return nil
	}
	return Hook()
}
-- cmd/app/main.go --
package main

import (
	"fmt"
	"io"

	"example.com/fx/internal/store"
)

var _ = io.EOF

func main() { fmt.Println(store.Run()) }
