package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func inner() error { return ErrX }

func /*@f*/F() error {
	if err := inner(); err != nil {
		return fmt.Errorf("f: %w", err)
	}
	return nil
}
