-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import "errors"

var ErrX = errors.New("x")

func work(n int) {
	if n == 0 {
		panic(ErrX)
	}
}

func /*@f*/F(n int) (err error) {
	defer func() {
		if r := recover(); r != nil {
			err = r.(error)
		}
	}()
	work(n)
	return nil
}
