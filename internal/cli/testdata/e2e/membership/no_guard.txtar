A guard removes the Sentinel on its way to the Target: where errors.Is(err, X) is false, err is not X, and the upward pass does not carry the Mark of X past the check. The Target is not reached: no.
-- args --
-is example.com/fx.ErrX a.go:@g
-- stdout --
$WORK/a.go:15:12-13: example.com/fx.ErrX in Error Set of example.com/fx.G: no
-- exit --
1
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import "errors"

var ErrX = errors.New("x")
var ErrY = errors.New("y")

func source(n int) error {
	if n == 0 {
		return ErrX
	}
	return ErrY
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, ErrX) {
		return nil
	}
	return err
}

func main() { G(1) }
