The Error Set resolves the result to another Sentinel, ErrY, whose value wraps ErrX: that entry is a Carrier, with the trace of the Mark into the variable.
-- args --
-is example.com/fx.ErrX a.go:@f
-- stdout --
$WORK/a.go:11:12-13: example.com/fx.ErrX in Error Set of example.com/fx.F: yes
$WORK/a.go:8:5-9: sentinel example.com/fx.ErrX
	wrap chain (origin → target):
		$WORK/a.go:9:5-9: fmt.Errorf "y: %w"
	path (origin → target):
		$WORK/a.go:11:31-35: in example.com/fx.F
-- stderr --
errtrace: warning: target not reachable from main/init; parameters may lack candidates
-- exit --
0
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")
var ErrY = fmt.Errorf("y: %w", ErrX)

func /*@f*/F() error { return ErrY }
