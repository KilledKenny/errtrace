module example.com/fx

go 1.24
-- a.go --
package fx

import "errors"

type MyErr struct{ code int }

func (*MyErr) Error() string { return "my" }

var ErrX error = &MyErr{code: 1}

func source(n int) error {
	if n == 0 {
		p := ErrX.(*MyErr)
		return p
	}
	if n == 1 {
		var p *MyErr
		errors.As(ErrX, &p)
		return p
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, ErrX) {
		return nil
	}
	return err
}
