package fx

import (
	"errors"
	"io"
)

func source(n int) error {
	var e error
	if n == 0 {
		e = io.EOF
	}
	return errors.Join(e, io.ErrUnexpectedEOF)
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
