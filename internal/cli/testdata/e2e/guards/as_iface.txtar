package fx

import (
	"errors"
	"io"
	"io/fs"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return fs.ErrNotExist
	case 2:
		return &MyErr{}
	}
	return errors.New("x")
}

type TimeoutErr struct{}

func (TimeoutErr) Error() string { return "timeout" }
func (TimeoutErr) Timeout() bool { return true }

func /*@g*/G(n int) error {
	err := source(n)
	if n == 5 {
		err = TimeoutErr{}
	}
	var te interface{ Timeout() bool }
	if errors.As(err, &te) {
		return nil
	}
	return err
}
