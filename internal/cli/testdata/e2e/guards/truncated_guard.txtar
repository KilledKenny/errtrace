A guard on the inner operand of a Wrap applies below the Wrap Chain depth limit too: with -chain-depth=1, io.EOF is removed from the truncated leaves of the double wrap.
-- args --
-chain-depth=1 a.go:@g
-- stdout --
$WORK/a.go:16:12-13: Error Set of example.com/fx.G: 1 entries
$WORK/a.go:13:9-24: opaque errors.New "x" [chain truncated]
	wrap chain (origin → target):
		$WORK/a.go:21:9-52: fmt.Errorf "b %w"
	path (origin → target):
		$WORK/a.go:13:9-24: in example.com/fx.source
		$WORK/a.go:17:9-18: in example.com/fx.G, call to example.com/fx.source
-- stderr --
errtrace: warning: target not reachable from main/init; parameters may lack candidates
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
	"io"
)

func source(n int) error {
	if n == 0 {
		return io.EOF
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == io.EOF {
		return nil
	}
	return fmt.Errorf("b %w", fmt.Errorf("a %w", err))
}
