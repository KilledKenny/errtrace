-- a.go --
package fx

import (
	"errors"
	"fmt"
	"io"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

var ErrMine error = &MyErr{}

func source(n int) error {
	if n == 0 {
		return io.EOF
	}
	return ErrMine
}

func /*@g*/G(n int) error {
	err := source(n)
	var pe *MyErr
	if errors.As(err, &pe) {
		return fmt.Errorf("my: %w", err)
	}
	return err
}
