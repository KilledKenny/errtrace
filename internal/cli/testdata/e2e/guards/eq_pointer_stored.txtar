package fx

import "errors"

type MyErr struct{ code int }

func (*MyErr) Error() string { return "my" }

var ErrX error = errors.New("x")

func source() error {
	e := &MyErr{code: 1}
	ErrX = e
	return e
}

func /*@g*/G() error {
	err := source()
	if err == ErrX {
		return err
	}
	return nil
}
