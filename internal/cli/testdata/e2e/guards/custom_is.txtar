package fx

import (
	"errors"
	"io"
)


type IsErr struct{}

func (*IsErr) Error() string          { return "is" }
func (*IsErr) Is(target error) bool { return target == io.EOF }

func src(n int) error {
	if n == 0 {
		return io.EOF
	}
	return &IsErr{}
}

func /*@g*/G(n int) error {
	err := src(n)
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
