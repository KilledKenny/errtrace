-- a.go --
package fx

import (
	"fmt"
	"io"
)

type WrapErr struct{ inner error }

func (e *WrapErr) Error() string { return "wrap: " + e.inner.Error() }
func (e *WrapErr) Unwrap() error { return e.inner }

var ErrX error

func source(n int) error {
	if n == 0 {
		e := fmt.Errorf("f: %w", io.ErrUnexpectedEOF)
		ErrX = e
		return e
	}
	e := &WrapErr{inner: io.EOF}
	ErrX = e
	return e
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == ErrX {
		return err
	}
	return nil
}
