package fx

import (
	"errors"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func source(n int) error {
	w := &W{inner: io.EOF}
	if n == 1 {
		w.inner = nil
	}
	return w
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
