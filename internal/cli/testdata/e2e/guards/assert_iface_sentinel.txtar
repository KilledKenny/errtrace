$WORK/a.go:9:5-12: sentinel example.com/fx.ErrMine
	path (origin → target):
		$WORK/a.go:16:10-17: in example.com/fx.source
		$WORK/a.go:22:9-18: in example.com/fx.G, call to example.com/fx.source
$WORK/a.go:18:9-17: concrete *example.com/fx.MyErr
	path (origin → target):
		$WORK/a.go:18:9-17: in example.com/fx.source
		$WORK/a.go:22:9-18: in example.com/fx.G, call to example.com/fx.source
