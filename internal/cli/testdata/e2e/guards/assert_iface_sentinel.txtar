-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import "io"

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

var ErrMine error = &MyErr{}

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return ErrMine
	}
	return &MyErr{}
}

func /*@g*/G(n int) error {
	err := source(n)
	if _, ok := err.(*MyErr); ok {
		return err
	}
	return nil
}
