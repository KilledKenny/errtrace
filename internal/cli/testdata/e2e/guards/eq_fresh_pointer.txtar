package fx

type MyErr struct{ code int }

func (*MyErr) Error() string { return "my" }

var ErrX error = &MyErr{code: 1}

func source() error { return &MyErr{code: 2} }

func /*@g*/G() error {
	err := source()
	if err == ErrX {
		return err
	}
	return nil
}
