package fx

import (
	"errors"
	"fmt"
	"io"
)

func read() (int, error) { return 0, io.EOF }

func source() error {
	_, err := read()
	return fmt.Errorf("read: %w", err)
}

func /*@g*/G() error {
	err := source()
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
