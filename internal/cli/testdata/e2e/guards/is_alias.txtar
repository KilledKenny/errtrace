package fx

import (
	"errors"
	"fmt"
	"io/fs"
	"os"
)

func source(n int) error {
	if n == 0 {
		return fs.ErrNotExist
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, os.ErrNotExist) {
		return fmt.Errorf("missing: %w", err)
	}
	return nil
}
