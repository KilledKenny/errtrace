package fx

import "errors"

type ZeroErr struct{}

func (*ZeroErr) Error() string { return "zero" }

var ErrA error = &ZeroErr{}

func source(n int) error {
	if n == 0 {
		return &ZeroErr{}
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == ErrA {
		return err
	}
	return nil
}
