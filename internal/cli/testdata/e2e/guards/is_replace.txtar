-- a.go --
package fx

import (
	"errors"
	"io"
	"io/fs"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return fs.ErrNotExist
	case 2:
		return &MyErr{}
	}
	return errors.New("x")
}

var ErrLocal = errors.New("local")

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, fs.ErrNotExist) {
		return ErrLocal
	}
	return err
}
