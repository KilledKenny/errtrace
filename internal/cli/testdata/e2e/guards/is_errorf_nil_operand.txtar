package fx

import (
	"errors"
	"fmt"
	"io"
)

func source(n int) error {
	var e error
	if n == 0 {
		e = io.EOF
	}
	return fmt.Errorf("w: %w", e)
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
