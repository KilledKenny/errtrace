-- a.go --
package fx

import "errors"

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

var flag bool

func pick() error {
	if flag {
		return &MyErr{}
	}
	return errors.New("other")
}

var ErrPicked = pick()

func /*@g*/G() error {
	err := ErrPicked
	if _, ok := err.(*MyErr); ok {
		return nil
	}
	return err
}
