package fx

import (
	"errors"
	"io/fs"
	"os"
)

func source(n int) error {
	if n == 0 {
		return fs.ErrNotExist
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == os.ErrNotExist {
		return err
	}
	return nil
}
