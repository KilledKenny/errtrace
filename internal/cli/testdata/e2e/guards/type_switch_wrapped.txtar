package fx

import (
	"fmt"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

func source2() error {
	return fmt.Errorf("w: %w", &MyErr{})
}

func /*@g*/G() error {
	err := source2()
	switch err.(type) {
	case *MyErr:
		return nil
	default:
		return err
	}
}
