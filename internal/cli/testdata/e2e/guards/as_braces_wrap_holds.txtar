package fx

import (
	"errors"
	"fmt"
	"io"

	"braces.dev/errtrace"
)

func source() error { return errtrace.Wrap(io.EOF) }

func /*@g*/G() error {
	err := source()
	var f fmt.Formatter
	if errors.As(err, &f) {
		return err
	}
	return nil
}

func /*@h*/H() error {
	err := source()
	var f fmt.Formatter
	if errors.As(err, &f) {
		return nil
	}
	return err
}
