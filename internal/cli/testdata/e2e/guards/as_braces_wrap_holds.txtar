-- errtrace/errtrace.go --
package errtrace

import (
	"fmt"
	"log/slog"
)

type errTrace struct {
	err error
	pc  uintptr
}

func (e *errTrace) Error() string                  { return e.err.Error() }
func (e *errTrace) Unwrap() error                  { return e.err }
func (e *errTrace) Format(s fmt.State, verb rune)  { fmt.Fprint(s, e.err) }
func (e *errTrace) LogValue() slog.Value           { return slog.StringValue(e.err.Error()) }
func (e *errTrace) TracePC() uintptr               { return e.pc }

func Wrap(err error) error {
	if err == nil {
		return nil
	}
	return &errTrace{err: err}
}
