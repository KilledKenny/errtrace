package fx

import "errors"

type ZeroErr struct{}

func (*ZeroErr) Error() string { return "zero" }

var ErrA error = &ZeroErr{}

func source() error { return &ZeroErr{} }

func /*@g*/G() error {
	err := source()
	if errors.Is(err, ErrA) {
		return nil
	}
	return err
}
