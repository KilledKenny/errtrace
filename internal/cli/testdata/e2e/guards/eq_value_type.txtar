package fx

type V struct{ s string }

func (V) Error() string { return "v" }

type W struct{ s string }

func (W) Error() string { return "w" }

var ErrV error = V{"a"}

func source(n int) error {
	if n == 0 {
		return W{"a"}
	}
	return V{"a"}
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == ErrV {
		return err
	}
	return nil
}
