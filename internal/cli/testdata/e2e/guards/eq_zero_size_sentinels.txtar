package fx

type ZeroErr struct{}

func (*ZeroErr) Error() string { return "zero" }

var ErrA, ErrB error = &ZeroErr{}, &ZeroErr{}

func source() error { return ErrB }

func /*@g*/G() error {
	err := source()
	if err == ErrA {
		return err
	}
	return nil
}
