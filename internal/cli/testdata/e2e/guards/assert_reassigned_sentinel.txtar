package fx

import "errors"

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

var ErrX error = errors.New("x")

func init() { ErrX = &MyErr{} }

func source() error { return ErrX }

func /*@g*/G() error {
	err := source()
	if _, ok := err.(*MyErr); ok {
		return err
	}
	return nil
}
