package fx

import (
	"errors"
	"io"
)

var ErrAlias = io.EOF

func source(n int) error {
	if n == 0 {
		return io.EOF
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == ErrAlias {
		return nil
	}
	return err
}
