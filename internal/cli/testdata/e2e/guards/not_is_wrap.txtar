-- a.go --
package fx

import (
	"errors"
	"fmt"
	"io"
	"io/fs"
)

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return fs.ErrNotExist
	case 2:
		return &MyErr{}
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if !errors.Is(err, io.EOF) {
		return err
	}
	return fmt.Errorf("eof: %w", err)
}
