package fx

import "errors"

var ErrX error

func source(n int) error {
	if n == 0 {
		e := errors.New("x")
		ErrX = e
		return e
	}
	return errors.New("other")
}

func /*@g*/G(n int) error {
	err := source(n)
	if errors.Is(err, ErrX) {
		return err
	}
	return nil
}
