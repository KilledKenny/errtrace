package fx

import (
	"errors"
	"fmt"
	"io"
)


var ErrA = errors.New("a")

func source2(n int) error {
	if n == 0 {
		return fmt.Errorf("w: %w", io.EOF)
	}
	return ErrA
}

func /*@g*/G(n int) error {
	err := source2(n)
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}
