-- a.go --
package fx

import "errors"

type MyErr struct{ code int }

func (*MyErr) Error() string { return "my" }

var ErrX error = mk()

func mk() error {
	var p *MyErr
	return p
}

func source(n int) error {
	if n == 0 {
		var p *MyErr
		return p
	}
	return errors.New("x")
}

func /*@g*/G(n int) error {
	err := source(n)
	if err == ErrX {
		return err
	}
	return nil
}
