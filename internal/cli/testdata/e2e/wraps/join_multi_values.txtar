-- a.go --
package fx

import "errors"

var (
	ErrA = errors.New("a")
	ErrB = errors.New("b")
	ErrC = errors.New("c")
	ErrY = errors.New("y")
)

func pick(n int) error {
	switch n {
	case 0:
		return ErrA
	case 1:
		return ErrB
	}
	return ErrC
}

func /*@p*/P(n, m int) error { return errors.Join(pick(n), pick(m), ErrY) }
