-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func /*@f*/F(n int) error {
	if n == 0 {
		return ErrX
	}
	return fmt.Errorf("r: %w", F(n-1))
}
