-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var (
	ErrB = errors.New("b")
	ErrX = errors.New("x")
	ErrY = errors.New("y")
)

func get() error { return ErrX }

func pass(e error) error { return fmt.Errorf("p: %w", e) }

func /*@q*/Q(n int) error {
	err := ErrB
	for i := 0; i < n; i++ {
		err = errors.Join(get(), pass(err), ErrY)
	}
	return err
}
