package fx

import "errors"

var (
	ErrA = errors.New("a")
	ErrY = errors.New("y")
)

func get() error { return ErrA }

func both(a, b error) error { return errors.Join(a, b) }

func /*@p*/P() error { return both(get(), ErrY) }
