$WORK/a.go:8:5-9: sentinel example.com/fx.ErrX [chain truncated]
	wrap chain (origin → target):
		$WORK/a.go:13:9-42: fmt.Errorf "step %d: %w"
		$WORK/a.go:13:9-42: fmt.Errorf "step %d: %w"
		$WORK/a.go:13:9-42: fmt.Errorf "step %d: %w"
	path (origin → target):
		$WORK/a.go:11:9-13: in example.com/fx.F
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func /*@f*/F(xs []int) error {
	err := ErrX
	for _, x := range xs {
		err = fmt.Errorf("step %d: %w", x, err)
	}
	return err
}
