-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func wrap(err error) error { return fmt.Errorf("wrap: %w", err) }

func /*@f*/F() error { return wrap(errors.Join(ErrX, nil)) }
