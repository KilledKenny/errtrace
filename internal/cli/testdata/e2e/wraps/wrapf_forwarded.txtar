module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func wrapf(format string, args ...any) error { return fmt.Errorf(format, args...) }

func /*@f*/F() error { return wrapf("y: %w", ErrX) }
