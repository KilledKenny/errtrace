package fx

import "errors"

var ErrX = errors.New("x")

type lazyErr struct{ code int }

func (e *lazyErr) Error() string { return "lazy" }
func (e *lazyErr) Unwrap() error {
	if e.code > 0 {
		return ErrX
	}
	return nil
}

func /*@f*/F() error { return &lazyErr{code: 1} }
