-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func wrapf(format string, args ...any) error { return fmt.Errorf(format, args...) }

func outer(format string, args ...any) error { return wrapf(format, args...) }

func get() error { return ErrX }

func /*@f*/F(n int) error { return outer("n=%d: %w", n, get()) }
