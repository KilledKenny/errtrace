errtrace: warning: target not reachable from main/init; parameters may lack candidates
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrB = errors.New("b")

func pass(e error) error { return fmt.Errorf("p: %w", e) }

func /*@q*/Q(n int) error {
	err := ErrB
	for i := 0; i < n; i++ {
		err = pass(err)
	}
	return err
}
