-- a.go --
package fx

import "errors"

var (
	ErrA = errors.New("a")
	ErrB = errors.New("b")
)

type multiErr struct{ errs []error }

func (m multiErr) Error() string   { return "multi" }
func (m multiErr) Unwrap() []error { return m.errs }

func /*@f*/F() error { return multiErr{errs: []error{ErrA, ErrB}} }
