A chain of exactly -chain-depth Wraps is kept whole: with -chain-depth=1 a single %w is not marked [chain truncated].
-- args --
-chain-depth=1 a.go:@g
-- stdout --
$WORK/a.go:10:12-13: Error Set of example.com/fx.G: 1 entries
$WORK/a.go:8:5-9: sentinel example.com/fx.ErrX
	wrap chain (origin → target):
		$WORK/a.go:11:9-33: fmt.Errorf "a %w"
	path (origin → target):
		$WORK/a.go:11:9-33: in example.com/fx.G
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

import (
	"errors"
	"fmt"
)

var ErrX = errors.New("x")

func /*@g*/G() error {
	return fmt.Errorf("a %w", ErrX)
}

func /*@h*/H() error {
	return fmt.Errorf("b %w", fmt.Errorf("a %w", ErrX))
}
