package fx

import (
	"errors"
	"fmt"
)

var (
	ErrA = errors.New("a")
	ErrY = errors.New("y")
)

func get() error { return ErrA }

func /*@p*/P() error { return fmt.Errorf("%w %w", get(), ErrY) }
