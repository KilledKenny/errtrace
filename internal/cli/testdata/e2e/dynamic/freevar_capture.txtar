package main

import (
	"errors"
	"os"
)

var ErrEmpty = errors.New("empty")

func open(name string) (*os.File, error) {
	if name == "" {
		return nil, ErrEmpty
	}
	return nil, os.ErrNotExist
}

func outer(name string) func() error {
	var err error
	if name == "-" {
		err = os.ErrInvalid
	} else {
		_, err = open(name)
	}
	return /*@closure*/func() error {
		return err
	}
}

func main() {
	_ = outer(os.Args[0])()
}
