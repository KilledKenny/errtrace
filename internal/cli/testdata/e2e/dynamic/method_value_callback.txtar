package main

import (
	"fmt"
	"io"
)

type T struct{}

func (t *T) Wrap(err error) error { return fmt.Errorf("t: %w", err) }

func /*@apply*/apply(cb func(error) error) error { return cb(io.EOF) }

func main() {
	t := &T{}
	_ = apply(t.Wrap)
}
