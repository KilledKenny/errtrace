package main

import (
	"errors"
	"io"
)

var ErrLoad = errors.New("load")

type T struct{ ok bool }

func (t *T) Load() error {
	if t.ok {
		return io.EOF
	}
	return ErrLoad
}

func /*@run*/run(t *T) error {
	f := t.Load
	return f()
}

func main() {
	_ = run(&T{})
}
