package main

import "errors"

var (
	ErrA = errors.New("a")
	ErrB = errors.New("b")
	ErrC = errors.New("c")
)

type Getter interface{ Get() error }

type A struct{}

func (A) Get() error { return ErrA }

type B struct{}

func (*B) Get() error { return ErrB }

type C struct{}

func (C) Get() error { return ErrC }

func /*@use*/use(g Getter) error { return g.Get() }

func main() {
	_ = use(A{})
	_ = use(&B{})
}
