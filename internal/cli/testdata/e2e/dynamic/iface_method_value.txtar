package main

import "errors"

var ErrV = errors.New("v")

type Getter interface{ Get() error }

type V struct{}

func (V) Get() error { return ErrV }

func /*@run*/run(g Getter) error {
	f := g.Get
	return f()
}

func main() {
	_ = run(&V{})
}
