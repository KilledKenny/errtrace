module example.com/fx

go 1.24
-- a.go --
package main

import "errors"

var (
	ErrInt = errors.New("int")
	ErrStr = errors.New("str")
)

func Must[T any](v T, err error) (T, error) {
	return v, err
}

func /*@map*/Map[T any](xs []T, f func(T) (T, error)) ([]T, error) {
	var out []T
	for _, x := range xs {
		y, err := Must(f(x))
		if err != nil {
			return nil, err
		}
		out = append(out, y)
	}
	return out, nil
}

func main() {
	_, _ = Map([]int{1}, func(i int) (int, error) { return i, ErrInt })
	_, _ = Map([]string{"a"}, func(s string) (string, error) { return s, ErrStr })
}
