package main

import (
	"fmt"
	"io"
)

func selfWrap() func() error {
	err := error(io.EOF)
	err = fmt.Errorf("x: %w", err)
	return /*@closure*/func() error { return err }
}

func main() {
	_ = selfWrap()()
}
