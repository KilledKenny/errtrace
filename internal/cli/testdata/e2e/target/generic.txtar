package fx

func /*@map*/Map[T any](xs []T, f func(T) (T, error)) ([]T, error) {
	out := make([]T, 0, len(xs))
	for _, x := range xs {
		y, err := f(x)
		if err != nil {
			return nil, err
		}
		out = append(out, y)
	}
	return out, nil
}

func Use() error {
	_, err := Map([]string{"a"}, func(s string) (string, error) { return s, nil })
	if err != nil {
		return err
	}
	_, err = Map([]int{1}, func(i int) (int, error) { return i, nil })
	return err
}
