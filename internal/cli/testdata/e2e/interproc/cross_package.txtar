-- store/store.go --
package store

import "errors"

var ErrMissing = errors.New("missing")

type Error struct{}

func (*Error) Error() string { return "store" }

func Get() error {
	if missing() {
		return ErrMissing
	}
	return &Error{}
}

func missing() bool { return true }
