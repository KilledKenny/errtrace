-- a.go --
package fx

import "errors"

var (
	ErrEven = errors.New("even")
	ErrOdd  = errors.New("odd")
)

func /*@even*/even(n int) error {
	if n == 0 {
		return ErrEven
	}
	return odd(n - 1)
}

func odd(n int) error {
	if n == 0 {
		return ErrOdd
	}
	return even(n - 1)
}
