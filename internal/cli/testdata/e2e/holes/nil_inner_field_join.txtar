package main

import (
	"errors"
	"fmt"
	"io"
)

var _ = errors.Join

type S struct{ err error }

func (s *S) Err() error { return s.err }

func wrap(e error) error { return fmt.Errorf("w: %w", e) }

func (s *S) add(e error) { s.err = errors.Join(s.err, e) }

func /*@q*/B(s *S) error { return s.err }

func main() {
	s := &S{}
	s.add(io.EOF)
	fmt.Println(B(s))
}
