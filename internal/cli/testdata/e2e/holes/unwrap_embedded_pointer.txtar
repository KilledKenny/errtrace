$GOROOT/src/io/io.go:*: sentinel io.EOF
	path (origin → target):
		$WORK/a.go:19:55-61: in example.com/x.mk
		$WORK/a.go:21:45-49: in example.com/x.F, call to example.com/x.mk
		$GOROOT/src/errors/wrap.go:*: in errors.Unwrap
		$WORK/a.go:12:37-38: in (*example.com/x.W).Unwrap
		$GOROOT/src/errors/wrap.go:*: in errors.Unwrap, call to (*example.com/x.W).Unwrap (dynamic (interface{Unwrap() error}).Unwrap: 1 of 1 candidates)
		$WORK/a.go:21:31-50: in example.com/x.F, call to errors.Unwrap
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

type Outer struct {
	tag string
	*W
}

func mk() error { return Outer{tag: "t", W: &W{inner: io.EOF}} }

func /*@q*/F() error { return errors.Unwrap(mk()) }

func main() { fmt.Println(F(), mk()) }
