-- a.go --
package main

import (
	"fmt"
	"io"
	"os"
)

func src() error { return io.EOF }

func A() error {
	var err error
	w := func() { err = io.ErrShortBuffer }
	r := func() error { return err }
	w()
	return r()
}

func inner(e error) error {
	var err error
	func() { err = e }()
	return err
}

func B() error { return inner(os.ErrClosed) }

func /*@q*/C() (err error) {
	defer func() {
		if err != nil {
			err = fmt.Errorf("ctx: %w", err)
		}
	}()
	return src()
}

// nested: inner closure writes var of the grandparent; middle one returned and called later
func D() error {
	var err error
	mid := func() func() {
		return func() { err = io.ErrNoProgress }
	}
	mid()()
	return err
}

// closure writes a struct local's field
type R struct{ err error }

func E() error {
	var r R
	func() { r.err = io.ErrClosedPipe }()
	return r.err
}

// multiple assignment from a call tuple in closure
func two() (int, error) { return 0, os.ErrDeadlineExceeded }

func G() error {
	var err error
	func() { _, err = two() }()
	return err
}

// range/select/chan stores in closure
func H() error {
	var err error
	ch := make(chan error, 1)
	ch <- os.ErrInvalid
	func() { err = <-ch }()
	return err
}

// captured variable is pointer to a struct; err var captured by method value closure
type T struct{ p *error }

func (t T) set() { *t.p = io.ErrShortWrite }

func I() error {
	var err error
	t := T{&err}
	t.set()
	return err
}

func main() {
	fmt.Println(A(), B(), C(), D(), E(), G(), H(), I())
}
