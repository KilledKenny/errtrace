-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct {
	msg string
	Err error
}

func (w *W) Error() string { return w.msg }
func (w *W) Unwrap() error { return w.Err }

func newW() *W { return &W{msg: "x", Err: io.EOF} }

func (w *W) SetErr(e error) { w.Err = e }

func /*@t*/F() error {
	w := newW()
	w.SetErr(os.ErrClosed)
	return w
}

func /*@u*/U() error { return errors.Unwrap(F()) }

func main() { fmt.Println(F(), U()) }
