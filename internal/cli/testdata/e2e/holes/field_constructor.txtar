$WORK/a.go:10:31-53: opaque errors.New "computed"
	path (origin → target):
		$WORK/a.go:10:31-53: in example.com/fx.compute
		$WORK/a.go:13:28-37: in example.com/fx.NewS, call to example.com/fx.compute
		$WORK/a.go:13:23-37: in example.com/fx.NewS
		$WORK/a.go:16:34-39: in (*example.com/fx.S).Err
		$WORK/a.go:19:9-16: in example.com/fx.F, call to (*example.com/fx.S).Err
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import "errors"

type S struct {
	name string
	err  error
}

func compute() error { return errors.New("computed") }

func NewS() *S {
	return &S{name: "s", err: compute()}
}

func (s *S) Err() error { return s.err }

func /*@f*/F(s *S) error {
	return s.Err()
}

func main() {
	_ = F(NewS())
}
