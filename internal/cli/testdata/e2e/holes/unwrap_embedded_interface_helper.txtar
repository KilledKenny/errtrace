-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type Coder interface {
	error
	Unwrap() error
	Code() int
}

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }
func (w *W) Code() int     { return 1 }

type Outer struct {
	Coder
	msg string
}

func (o *Outer) Error() string { return o.msg }

func wrap(c Coder) error { return &Outer{c, "ctx"} }

func /*@q*/F() error {
	err := wrap(&W{inner: io.EOF})
	if errors.Is(err, io.EOF) {
		return errors.Unwrap(err)
	}
	return nil
}

func main() { fmt.Println(F()) }
