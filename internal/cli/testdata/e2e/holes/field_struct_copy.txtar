-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import "io"

type S struct{ err error }

func fill(dst, src *S) {
	*dst = *src
}

func keep(v S) *S {
	p := &v
	return p
}

func /*@f*/F(s *S) error {
	return s.err
}

func recv(ch chan S) *S {
	r := <-ch
	r.err = nil
	return &r
}

func main() {
	src := &S{err: io.EOF}
	dst := new(S)
	fill(dst, src)
	ch := make(chan S, 1)
	ch <- *dst
	_ = F(keep(*recv(ch)))
}
