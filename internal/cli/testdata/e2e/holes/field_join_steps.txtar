-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

var _ = errors.Join

type S struct{ a, b, c error }

func (s *S) step() {
	s.a = errors.Join(s.a, os.ErrInvalid)
	if s.b != nil {
		s.a = errors.Join(s.a, io.ErrShortWrite)
	}
}

func /*@q*/F(s *S) error { return s.a }

func main() {
	s := &S{a: io.EOF, b: os.ErrClosed, c: os.ErrExist}
	for i := 0; i < 3; i++ {
		s.step()
	}
	fmt.Println(F(s) != nil)
}
