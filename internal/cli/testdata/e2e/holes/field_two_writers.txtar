package main

import (
	"errors"
	"io"
)

type S struct{ err error }

var ErrSet = errors.New("set")

func (s *S) fail() { s.err = ErrSet }

func get(s *S) error { return s.err }

func /*@f*/F(n int) error {
	s := &S{err: io.EOF}
	if n > 0 {
		s.fail()
	}
	return get(s)
}

func main() {
	_ = F(0)
}
