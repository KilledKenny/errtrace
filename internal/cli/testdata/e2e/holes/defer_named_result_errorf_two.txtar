-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrGet = errors.New("get")
var ErrClose = errors.New("close")

func get(n int) error {
	if n > 0 {
		return ErrGet
	}
	return nil
}

func closeIt() error { return ErrClose }

func /*@t*/T(n int) (err error) {
	defer func() {
		if cerr := closeIt(); cerr != nil && err == nil {
			err = cerr
		}
	}()
	defer func() {
		if err != nil {
			err = fmt.Errorf("d2: %w", err)
		}
	}()
	err = get(n)
	if err != nil {
		return fmt.Errorf("f: %w", err)
	}
	return nil
}

func main() { fmt.Println(T(0), T(1)) }
