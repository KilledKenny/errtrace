-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }
func (w *W) Set(e error)   { w.inner = e }

type setter interface{ Set(error) }

func mk() error { return &W{inner: io.EOF} }

func set(err error) {
	if s, ok := err.(setter); ok {
		s.Set(os.ErrClosed)
	}
}

func /*@v*/V() error {
	err := mk()
	set(err)
	if errors.Is(err, os.ErrClosed) {
		return nil
	}
	return err
}

func main() { fmt.Println(V()) }
