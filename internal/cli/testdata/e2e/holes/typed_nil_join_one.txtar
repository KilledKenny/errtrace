-- a.go --
package main

import (
	"errors"
	"fmt"
)

type E struct{ a int }

func (*E) Error() string { return "e" }

var ErrNeg = errors.New("negative")

func check(n int) error {
	if n < 0 {
		return ErrNeg
	}
	return nil
}

func parse(a int, strict bool) (*E, error) {
	if strict {
		return nil, errors.Join(check(a))
	}
	return &E{a}, nil
}

func /*@t*/T(a int) error {
	e, err := parse(a, true)
	if err != nil {
		return err
	}
	return e
}

func main() { fmt.Println(T(1) != nil, T(-1)) }
