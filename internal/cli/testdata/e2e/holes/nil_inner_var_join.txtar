package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

func none() error { return nil }

func A() error { return errors.Join(none(), io.EOF) }

func B() error { return fmt.Errorf("%w; %w", none(), io.EOF) }

func /*@q*/C() error {
	var e error
	return errors.Join(e, io.EOF)
}

func D() (err error) {
	defer func() { err = errors.Join(err, os.ErrClosed) }()
	return nil
}

func E() error {
	var errs error
	for _, f := range []func() error{func() error { return io.EOF }} {
		func() { errs = errors.Join(errs, f()) }()
	}
	return errs
}

func main() { fmt.Println(A(), B(), C(), D(), E()) }
