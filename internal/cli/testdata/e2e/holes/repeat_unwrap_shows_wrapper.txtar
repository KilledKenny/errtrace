module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type W3 struct{ inner error }

func (w *W3) Error() string { return "w3" }
func (w *W3) Unwrap() error { return w.inner }

func F1() (err error) {
	defer func() { err = fmt.Errorf("x: %w", err) }()
	defer func() { err = &W3{inner: err} }()
	return io.EOF
}

func /*@q*/G1() error { return errors.Unwrap(F1()) }

func main() {
	var w3 *W3
	fmt.Println(errors.As(G1(), &w3))
}
