QA C3. A method that only text/template calls writes the field.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:19:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:19:31-41: unresolved(memory): field Err of example.com/x.S may be written by (example.com/x.Data).Fail, which only reflection can call
	path (origin → target):
		$WORK/a.go:19:31-41: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"os"
	"strings"
	"text/template"
)

type S struct{ Err error }

var global = &S{}

type Data struct{}

func (Data) Fail() string { global.Err = io.EOF; return "x" }

func /*@q*/F() error { return global.Err }

func main() {
	t := template.Must(template.New("t").Parse("{{.Fail}}"))
	var sb strings.Builder
	t.Execute(&sb, Data{})
	fmt.Fprintln(os.Stdout, F())
}
