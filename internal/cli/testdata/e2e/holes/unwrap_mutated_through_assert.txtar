module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func newE() error { return &W{inner: io.EOF} }

func /*@q*/F() error {
	err := newE()
	if w, ok := err.(*W); ok {
		w.inner = os.ErrClosed
	}
	return errors.Unwrap(err)
}

func main() { fmt.Println(F()) }
