package main

import (
	"fmt"
	"io"
	"os"
)

type S struct{ err error }

var gs = &S{}

func setS(e error)    { gs.err = e }
func load(s *S) error { return s.err }
func direct() error   { return os.ErrClosed }

func t(s *S, n int) error {
	if n == 0 {
		return load(s)
	}
	return p(s, n-1)
}
func r(s *S, n int) error {
	if n == 7 {
		return nil
	}
	return t(s, n-1)
}
func /*@q*/q(s *S, n int) error {
	if n == 5 {
		return nil
	}
	return r(s, n-1)
}
func p(s *S, n int) error {
	if n == 1 {
		return direct()
	}
	return q(s, n-1)
}

func main() {
	setS(io.EOF)
	setS(os.ErrClosed)
	fmt.Println(q(&S{}, 4))
}
