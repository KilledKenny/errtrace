package main

import (
	"fmt"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

func find(ok bool) (*E, error) {
	if !ok {
		return nil, io.EOF
	}
	return &E{}, nil
}

func /*@t*/T() error {
	e, _ := find(false)
	return e
}

func main() { fmt.Println(T() != nil) }
