-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"

	"braces.dev/errtrace"
)

func src() error { return errtrace.Wrap(io.EOF) }

func /*@q*/F() error { return errors.Unwrap(src()) }

func main() { fmt.Println(F()) }
-- errtrace/go.mod --
module braces.dev/errtrace

go 1.24
-- errtrace/errtrace.go --
package errtrace

type wrapped struct{ err error }

func (w *wrapped) Error() string { return w.err.Error() }
func (w *wrapped) Unwrap() error { return w.err }

func Wrap(err error) error {
	if err == nil {
		return nil
	}
	return &wrapped{err}
}
