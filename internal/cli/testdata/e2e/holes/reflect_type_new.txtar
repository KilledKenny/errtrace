QA3 C5. reflect.ValueOf(s).Type() hands out a reflect.Type, of which
reflect.New builds a value that is written by reflection and comes back
through a type assertion in another function. The Type is not "only
inspected": the struct is exposed, and the load keeps an Unresolved entry.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:11:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:11:35-40: unresolved(memory): field Err of example.com/x.S may be written by reflection, unsafe code or a function that is not seen
	path (origin → target):
		$WORK/a.go:11:35-40: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"reflect"
)

type S struct{ Err error }

func /*@q*/F(s *S) error { return s.Err }

func conv(a any) *S { return a.(*S) }

func main() {
	s := &S{}
	t := reflect.ValueOf(s).Type()
	v := reflect.New(t.Elem())
	v.Elem().Field(0).Set(reflect.ValueOf(io.EOF))
	fmt.Println(F(conv(v.Interface())))
}
