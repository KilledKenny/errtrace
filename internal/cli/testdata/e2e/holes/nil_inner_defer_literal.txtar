-- a.go --
package main

import "fmt"

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func none() error { return nil }

type S struct{ err error }

func (s *S) wrap() { s.err = &W{inner: s.err} }

func A() error { return &W{inner: none()} }

func B(s *S) error { return s.err }

func /*@q*/C() (err error) {
	defer func() { err = &W{inner: err} }()
	return nil
}

func D() (err error) {
	defer func() { err = fmt.Errorf("ctx: %w", err) }()
	return nil
}

func main() {
	s := &S{}
	s.wrap()
	fmt.Println(A(), B(s), C(), D())
}
