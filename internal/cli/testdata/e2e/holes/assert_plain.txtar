package main

import (
	"errors"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

type T struct{}

func (*T) Error() string { return "t" }
func (*T) Timeout() bool { return true }

type timeout interface {
	error
	Timeout() bool
}

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return &E{}
	case 2:
		return &T{}
	}
	return errors.New("x")
}

func /*@f*/F(n int) error {
	var x any = source(n)
	return x.(error)
}

func main() {
	_ = F(0)
}
