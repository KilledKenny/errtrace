package main

import (
	"errors"
	"fmt"
	"io"
)

type S struct{ err error }

func (s *S) Err() error { return s.err }

func (s *S) add(e error) { s.err = errors.Join(s.Err(), e) }

func /*@q*/A(s *S) error { return s.Err() }

func B(s *S) error { return s.err }

func main() {
	s := &S{}
	s.add(io.EOF)
	fmt.Println(A(s), B(s))
}
