A closure nested in a closure writes the variable: the store is followed
through both captures.
-- args --
a.go:@f
-- stdout --
$WORK/a.go:7:12-13: Error Set of example.com/fx.F: 1 entries
$WORK/a.go:5:5-12: sentinel example.com/fx.ErrDeep
	path (origin → target):
		$WORK/a.go:11:10-17: in example.com/fx.F$1$1
		$WORK/a.go:11:4-7: in example.com/fx.F$1$1
		$WORK/a.go:16:9-12: in example.com/fx.F
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import "errors"

var ErrDeep = errors.New("deep")

func /*@f*/F() error {
	var err error
	outer := func() {
		inner := func() {
			err = ErrDeep
		}
		inner()
	}
	outer()
	return err
}

func main() {
	_ = F()
}
