QA6 C1. The defer statement is in the body of a range-over-func loop: it
defers into the frame of T, and the deferred closure recovers. After the
panic T returns what its named result held then, ErrHalf. (Run time: T(1) is
ErrHalf.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:18:12-13: Error Set of example.com/x.T: 1 entries
$WORK/a.go:8:5-12: sentinel example.com/x.ErrHalf
	path (origin → target):
		$WORK/a.go:22:8-15: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrHalf = errors.New("half done")

func step(n int) {
	if n > 0 {
		panic("boom")
	}
}

func seq(yield func(int) bool) { yield(1) }

func /*@t*/T(n int) (err error) {
	for range seq {
		defer func() { recover() }()
	}
	err = ErrHalf
	step(n)
	err = nil
	return
}

func main() { fmt.Println(T(1)) }
