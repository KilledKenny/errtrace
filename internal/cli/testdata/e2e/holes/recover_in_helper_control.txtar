QA6 C1, control. The deferred closure calls a helper that calls recover:
recover has no effect there, the panic goes on, and T never returns the
ErrHalf its named result held. (Run time: T(1) panics.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:18:12-13: Error Set of example.com/x.T: 0 entries
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrHalf = errors.New("half done")

func step(n int) {
	if n > 0 {
		panic("boom")
	}
}

func rec() { recover() }

func /*@t*/T(n int) (err error) {
	defer func() { rec() }()
	err = ErrHalf
	step(n)
	err = nil
	return
}

func main() { fmt.Println(T(1)) }
