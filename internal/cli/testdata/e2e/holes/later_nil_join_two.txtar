module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

var ErrNeg = errors.New("negative")

func check(n int) error {
	if n < 0 {
		return ErrNeg
	}
	return nil
}

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func mk() error { return &W{inner: io.EOF} }

func /*@t*/T(a, b int) error {
	err := mk()
	err.(*W).inner = errors.Join(check(a), check(b))
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}

func main() { fmt.Printf("%#v\n", T(1, 2)) }
