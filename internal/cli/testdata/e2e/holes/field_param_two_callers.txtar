-- a.go --
package main

import (
	"errors"
	"io"
)

type E struct{ Err error }

func (e *E) Error() string { return "e" }

func NewE(err error) *E { return &E{Err: err} }

var ErrOther = errors.New("other")

func a() *E { return NewE(io.EOF) }
func b() *E { return NewE(ErrOther) }

func inner(e *E) error { return e.Err }

func /*@f*/F(n int) error {
	if n > 0 {
		return inner(a())
	}
	return inner(b())
}

func main() {
	_ = F(0)
}
