-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type S struct{ err error }
type T struct{ err error }

func (s *S) wrap() { s.err = fmt.Errorf("w: %w", s.err) }

func (s *S) relay(t *T) {
	e := s.err
	if e == io.EOF {
		return
	}
	t.err = e
}

func (s *S) back(t *T) { s.err = t.err }

func /*@q*/FT(t *T) error { return t.err }

func F0() (err error) {
	defer func() { err = fmt.Errorf("ctx: %w", err) }()
	return io.EOF
}

func G() error {
	err := F0()
	if err == io.EOF {
		return nil
	}
	return err
}

func main() {
	s, t := &S{err: io.EOF}, &T{}
	s.relay(t)
	s.wrap()
	s.relay(t)
	s.back(t)
	fmt.Println(FT(t), G())
}
