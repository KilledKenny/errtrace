-- a.go --
package main

import (
	"errors"
	"fmt"
)

type E struct{ a, b int }

func (*E) Error() string { return "e" }

var ErrNeg = errors.New("negative")

func check(n int) error {
	if n < 0 {
		return ErrNeg
	}
	return nil
}

func parse(a, b int, strict bool) (*E, error) {
	if strict {
		return nil, errors.Join(check(a), check(b))
	}
	return &E{a, b}, nil
}

func /*@t*/T(a, b int) error {
	e, err := parse(a, b, true)
	if err != nil {
		return err
	}
	return e
}

func main() { fmt.Println(T(1, 2) != nil, T(-1, 2)) }
