-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"os"
)

type S struct{ a, b, c, d, e error }

func setA(s *S, e error) { s.a = e }
func setB(s *S, e error) { s.b = e }
func setC(s *S, e error) { s.c = e }
func setD(s *S, e error) { s.d = e }
func setE(s *S, e error) { s.e = e }

type holder struct{ f func(*S, error) }

var global func(*S, error)

func A(s *S) error { return s.a }
func /*@q*/B(s *S) error { return s.b }
func C(s *S) error { return s.c }
func D(s *S) error { return s.d }
func E(s *S) error { return s.e }

func main() {
	s := &S{}
	fns := []func(*S, error){setA}
	for _, f := range fns {
		f(s, io.EOF)
	}
	ch := make(chan func(*S, error), 1)
	ch <- setB
	(<-ch)(s, os.ErrClosed)
	h := holder{f: setC}
	func() { defer h.f(s, os.ErrExist) }()
	global = setD
	done := make(chan bool)
	go func() { global(s, os.ErrInvalid); close(done) }()
	<-done
	var i interface{ Set(error) } = setter{s}
	m := i.Set
	m(os.ErrPermission)
	fmt.Println(A(s), B(s), C(s), D(s), E(s))
}

type setter struct{ s *S }

func (x setter) Set(e error) { setE(x.s, e) }
