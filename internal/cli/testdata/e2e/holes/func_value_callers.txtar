$GOROOT/src/os/error.go:*: sentinel os.ErrClosed [via field b of example.com/x.S]
	path (origin → target):
		$WORK/a.go:35:12-24: in example.com/x.main
		$WORK/a.go:35:2-25: in example.com/x.main, call to example.com/x.setB
		$WORK/a.go:12:34-35: in example.com/x.setB
