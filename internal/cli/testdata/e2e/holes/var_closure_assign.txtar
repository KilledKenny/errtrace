module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

func step(n int) error {
	if n > 0 {
		return errors.New("step")
	}
	return nil
}

func run(f func()) { f() }

func /*@f*/F(n int) error {
	var err error
	run(func() {
		err = step(n)
	})
	if n == 7 {
		err = io.EOF
	}
	return err
}

func main() {
	_ = F(0)
}
