QA5 M1. A wrapper loaded from a struct field of the wrapper's pointer type:
not a tracked value, so its Wrap holds one Unresolved value. (Run time: the
wrapper holds io.EOF.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:20:12-13: Error Set of example.com/x.T: 2 entries, 1 unresolved
$WORK/a.go:23:10-15: concrete *example.com/x.W
	path (origin → target):
		$WORK/a.go:23:10-15: in example.com/x.T
$WORK/a.go:23:10-15: unresolved(memory): field inner of example.com/x.W: the wrapper is not a tracked value
	wrap chain (origin → target):
		$WORK/a.go:23:10-15: *example.com/x.W.Unwrap
	path (origin → target):
		$WORK/a.go:23:10-15: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

type Res struct {
	N   int
	Err *W
}

func work() Res { return Res{Err: &W{inner: io.EOF}} }

func /*@t*/T() error {
	r := work()
	if r.Err != nil {
		return r.Err
	}
	return nil
}

func main() { fmt.Println(T()) }
