module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct {
	msg string
	Err error
}

func (w *W) Error() string { return w.msg }
func (w *W) Unwrap() error { return w.Err }

func src() error { return &W{msg: "x", Err: io.EOF} }

func /*@t*/F() error {
	err := src()
	var w *W
	if errors.As(err, &w) {
		w.Err = os.ErrClosed
	}
	return err
}

func /*@u*/U() error { return errors.Unwrap(F()) }

func main() { fmt.Println(F(), U()) }
