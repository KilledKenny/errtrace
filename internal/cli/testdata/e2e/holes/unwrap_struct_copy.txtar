-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func newW() *W { return &W{inner: io.EOF} }

func other() error { return &W{inner: os.ErrExist} }

func /*@q*/F() error {
	p := newW()
	q := &W{inner: os.ErrClosed}
	*p = *q
	return errors.Unwrap(p)
}

func main() { fmt.Println(F(), other()) }
