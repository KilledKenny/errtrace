QA C3. A method called with reflect's MethodByName writes the field.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:17:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:17:31-41: unresolved(memory): field Err of example.com/x.S may be written by (example.com/x.H).Fail, which only reflection can call
	path (origin → target):
		$WORK/a.go:17:31-41: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"reflect"
)

type S struct{ Err error }

var global = &S{}

type H struct{}

func (H) Fail() { global.Err = io.EOF }

func /*@q*/F() error { return global.Err }

func main() {
	reflect.ValueOf(H{}).MethodByName("Fail").Call(nil)
	fmt.Println(F())
}
