QA6 C1. The deferred call is a method expression of a pointer receiver
((*guard).rec(nil)): recover works through the wrapper that stands for the
method. After the panic T returns what its named result held then, ErrHalf.
(Run time: T(1) is ErrHalf.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:20:12-13: Error Set of example.com/x.T: 1 entries
$WORK/a.go:8:5-12: sentinel example.com/x.ErrHalf
	path (origin → target):
		$WORK/a.go:22:8-15: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrHalf = errors.New("half done")

func step(n int) {
	if n > 0 {
		panic("boom")
	}
}

type guard struct{}

func (*guard) rec() { recover() }

func /*@t*/T(n int) (err error) {
	defer (*guard).rec(nil)
	err = ErrHalf
	step(n)
	err = nil
	return
}

func main() { fmt.Println(T(1)) }
