-- a.go --
package main

import (
	"fmt"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

func find(ok bool) (*E, error) {
	if !ok {
		return nil, io.EOF
	}
	return &E{}, nil
}

func find2(ok bool) (*E, error) {
	e, _ := find(ok)
	return e, nil
}

func /*@t*/T() error {
	e, err := find2(false)
	if err != nil {
		return err
	}
	return e
}

func main() { fmt.Println(T() != nil) }
