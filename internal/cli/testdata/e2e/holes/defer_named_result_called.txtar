module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrGet = errors.New("get")
var ErrClose = errors.New("close")

func get(n int) error {
	if n > 0 {
		return ErrGet
	}
	return nil
}

func /*@t*/T(n int) (err error) {
	fix := func() {
		if err == nil {
			err = ErrClose
		}
	}
	defer fix()
	err = get(n)
	fix()
	if err != nil {
		return fmt.Errorf("f: %w", err)
	}
	return nil
}

func main() { fmt.Println(T(0), T(1)) }
