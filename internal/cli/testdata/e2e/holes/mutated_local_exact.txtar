QA4 pre-existing 1, control. The stores that the building function makes
through the literal's own pointer are construction stores: with no later
writer of the field in the program, the Wrap holds exactly what they store.
-- args --
a.go:@t
-- stdout --
$WORK/a.go:16:12-13: Error Set of example.com/x.F: 1 entries
$GOROOT/src/os/error.go:*: sentinel os.ErrExist
	wrap chain (origin → target):
		$WORK/a.go:17:7-19: *example.com/x.W.Unwrap
	path (origin → target):
		$WORK/a.go:18:10-21: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"os"
)

type W struct {
	msg string
	Err error
}

func (w *W) Error() string { return w.msg }
func (w *W) Unwrap() error { return w.Err }

func /*@t*/F() error {
	e := &W{msg: "x"}
	e.Err = os.ErrExist
	return e
}

func main() { fmt.Println(F()) }
