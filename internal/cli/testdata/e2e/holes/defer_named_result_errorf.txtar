		$WORK/a.go:26:8-14: in example.com/x.T, call to example.com/x.get
$WORK/a.go:9:5-13: sentinel example.com/x.ErrClose [+1 more paths]
	path (origin → target):
		$WORK/a.go:18:31-39: in example.com/x.closeIt
		$WORK/a.go:22:14-23: in example.com/x.T$1, call to example.com/x.closeIt
		$WORK/a.go:23:4-7: in example.com/x.T$1
		$WORK/a.go:28:3-3: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrGet = errors.New("get")
var ErrClose = errors.New("close")

func get(n int) error {
	if n > 0 {
		return ErrGet
	}
	return nil
}

func closeIt() error { return ErrClose }

func /*@t*/T(n int) (err error) {
	defer func() {
		if cerr := closeIt(); cerr != nil && err == nil {
			err = cerr
		}
	}()
	err = get(n)
	if err != nil {
		return fmt.Errorf("f: %w", err)
	}
	return nil
}

func main() { fmt.Println(T(0), T(1)) }
