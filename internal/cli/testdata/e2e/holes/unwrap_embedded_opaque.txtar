-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

type Outer struct{ *W }

func wrap(w *W) error { return Outer{W: w} }

func /*@q*/F(w *W) error { return errors.Unwrap(wrap(w)) }

func main() { fmt.Println(F(&W{inner: io.EOF})) }
