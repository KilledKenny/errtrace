	path (origin → target):
		$WORK/a.go:22:55-61: in example.com/x.F
		$GOROOT/src/errors/wrap.go:*: in errors.Unwrap
		$WORK/a.go:13:37-38: in (*example.com/x.W).Unwrap
		$GOROOT/src/errors/wrap.go:*: in errors.Unwrap, call to (*example.com/x.W).Unwrap (dynamic (interface{Unwrap() error}).Unwrap: 2 of 2 candidates)
		$WORK/a.go:22:31-63: in example.com/x.F, call to errors.Unwrap
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

type V struct{ err error }

func (v V) Error() string { return "v" }
func (v V) Unwrap() error { return v.err }

func mkV() error { return V{err: os.ErrClosed} }

func /*@q*/F() error { return errors.Unwrap(&W{inner: io.EOF}) }

func main() { fmt.Println(F(), errors.Unwrap(mkV())) }
