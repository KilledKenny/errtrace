-- a.go --
package main

import "io"

type S struct{ err error }

func set(s *S, e error)    { s.err = e }
func l1(s *S, e error)     { set(s, e) }
func l2(s *S, e error)     { l1(s, e) }
func l3(s *S, e error)     { l2(s, e) }
func l4(s *S)              { l3(s, io.ErrUnexpectedEOF) }
func near(s *S)            { l2(s, io.EOF) }

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	s := new(S)
	l4(s)
	near(s)
	_ = F(s)
}
