-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

type V struct{ err error }

func (v V) Error() string { return "v" }
func (v V) Unwrap() error { return v.err }

var current error

func set(n int) {
	if n == 0 {
		current = &W{inner: io.EOF}
	} else {
		current = V{err: os.ErrClosed}
	}
}

func /*@q*/F() error { return errors.Unwrap(current) }

func main() {
	set(0)
	fmt.Println(F())
}
