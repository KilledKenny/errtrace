package main

import "fmt"

type E struct{}

func (*E) Error() string { return "e" }

func parse(s string) (*E, bool) {
	if s == "" {
		return nil, false
	}
	return &E{}, true
}

func /*@t*/T() error {
	if e, ok := parse("x"); ok {
		return e
	}
	return nil
}

func main() { fmt.Println(T()) }
