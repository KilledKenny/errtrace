module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

type T struct{}

func (*T) Error() string { return "t" }
func (*T) Timeout() bool { return true }

type timeout interface {
	error
	Timeout() bool
}

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return &E{}
	case 2:
		return &T{}
	}
	return errors.New("x")
}

func /*@f*/F(n int) error {
	if t, ok := source(n).(timeout); ok {
		return t
	}
	return nil
}

func main() {
	_ = F(0)
}
