QA5 M5. A later writer sets the field of a tracked wrapper to nil, and the
wrapper is returned without a guard: besides the Wrap of what the literal
stored, the wrapper with a nil field is listed. (Run time: the bare wrapper.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:24:12-13: Error Set of example.com/x.T: 2 entries
$GOROOT/src/io/io.go:*: sentinel io.EOF
	wrap chain (origin → target):
		$WORK/a.go:16:26-43: *example.com/x.W.Unwrap
	path (origin → target):
		$WORK/a.go:16:36-42: in example.com/x.mk
		$WORK/a.go:25:9-13: in example.com/x.T, call to example.com/x.mk
$WORK/a.go:16:26-43: concrete *example.com/x.W
	path (origin → target):
		$WORK/a.go:16:26-43: in example.com/x.mk
		$WORK/a.go:25:9-13: in example.com/x.T, call to example.com/x.mk
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }
func (w *W) Set(e error)   { w.inner = e }

type setter interface{ Set(error) }

func mk() error { return &W{inner: io.EOF} }

func clear(err error) {
	if s, ok := err.(setter); ok {
		s.Set(nil)
	}
}

func /*@t*/T() error {
	err := mk()
	clear(err)
	return err
}

func main() { fmt.Println(T()) }
