QA N3. A function that uses Value.UnsafeAddr and reflect.NewAt gets at the
unexported fields of what it reflects on.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:12:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:12:35-40: unresolved(memory): field err of example.com/x.S may be written by reflection, unsafe code or a function that is not seen
	path (origin → target):
		$WORK/a.go:12:35-40: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"reflect"
	"unsafe"
)

type S struct{ err error }

func /*@q*/F(s *S) error { return s.err }

func main() {
	s := &S{}
	f := reflect.ValueOf(s).Elem().Field(0)
	reflect.NewAt(f.Type(), unsafe.Pointer(f.UnsafeAddr())).Elem().Set(reflect.ValueOf(&io.EOF).Elem())
	fmt.Println(F(s))
}
