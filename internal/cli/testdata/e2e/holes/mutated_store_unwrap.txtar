-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct {
	msg string
	Err error
}

func (w *W) Error() string { return w.msg }
func (w *W) Unwrap() error { return w.Err }

func newW() *W { return &W{msg: "x", Err: io.EOF} }

func /*@t*/F() error {
	w := newW()
	w.Err = os.ErrClosed
	return fmt.Errorf("ctx: %w", w)
}

func /*@u*/U() error { return errors.Unwrap(errors.Unwrap(F())) }

func main() { fmt.Println(F(), U()) }
