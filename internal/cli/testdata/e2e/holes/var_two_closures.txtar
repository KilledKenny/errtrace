package main

import "errors"

var (
	ErrA = errors.New("a")
	ErrB = errors.New("b")
)

func /*@f*/F(n int) error {
	var err error
	a := func() { err = ErrA }
	b := func() { err = ErrB }
	if n > 0 {
		a()
	} else {
		b()
	}
	return err
}

func main() {
	_ = F(0)
}
