-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

var ErrP = errors.New("p")

func setp(p *error) { *p = ErrP }

func /*@f*/F(n int) error {
	var err error
	setp(&err)
	func() {
		if n > 1 {
			err = io.EOF
		}
	}()
	if n > 2 {
		err = io.ErrUnexpectedEOF
	}
	return err
}

func main() {
	_ = F(0)
}
