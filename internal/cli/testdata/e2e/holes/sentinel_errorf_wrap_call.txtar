QA5 M1. A Sentinel made by fmt.Errorf with %w of a call's result: the
initializer is not followed into the call, and the Wrap that is the Sentinel's
value holds one Unresolved value. (Run time: it wraps io.EOF.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:12:12-13: Error Set of example.com/x.T: 2 entries, 1 unresolved
$WORK/a.go:10:5-11: sentinel example.com/x.ErrFoo
	path (origin → target):
		$WORK/a.go:12:31-37: in example.com/x.T
$WORK/a.go:10:5-11: unresolved(memory): value of Sentinel main.ErrFoo may wrap other errors: its initializer is not followed
	wrap chain (origin → target):
		$WORK/a.go:10:5-11: fmt.Errorf "foo: %w"
	path (origin → target):
		$WORK/a.go:12:31-37: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

func base() error { return io.EOF }

var ErrFoo = fmt.Errorf("foo: %w", base())

func /*@t*/T() error { return ErrFoo }

func main() { fmt.Println(T()) }
