A type assertion to a concrete type keeps only the operand's values of that
type: here the *E that source builds, at the place it is built.
-- args --
a.go:@f
-- stdout --
$WORK/a.go:34:12-13: Error Set of example.com/fx.F: 1 entries
$WORK/a.go:27:10-14: concrete *example.com/fx.E
	path (origin → target):
		$WORK/a.go:27:10-14: in example.com/fx.source
		$WORK/a.go:35:10-19: in example.com/fx.F, call to example.com/fx.source
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

type T struct{}

func (*T) Error() string { return "t" }
func (*T) Timeout() bool { return true }

type timeout interface {
	error
	Timeout() bool
}

func source(n int) error {
	switch n {
	case 0:
		return io.EOF
	case 1:
		return &E{}
	case 2:
		return &T{}
	}
	return errors.New("x")
}

func /*@f*/F(n int) *E {
	e, _ := source(n).(*E)
	return e
}

func main() {
	_ = F(0)
}
