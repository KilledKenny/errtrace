-- a.go --
package main

import (
	"errors"
	"sync"
)

func work() error { return errors.New("work") }

func /*@f*/F() error {
	var (
		wg  sync.WaitGroup
		err error
	)
	wg.Add(1)
	go func() {
		defer wg.Done()
		err = work()
	}()
	wg.Wait()
	return err
}

func main() {
	_ = F()
}
