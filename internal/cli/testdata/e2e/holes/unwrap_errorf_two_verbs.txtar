QA3 C1. fmt.Errorf with two %w verbs gives a *fmt.wrapErrors, which has
Unwrap() []error and no Unwrap() error: errors.Unwrap of it is nil, and
errors.Join's value likewise.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:17:12-13: Error Set of example.com/x.F: 0 entries
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

func src(n int) error {
	if n == 0 {
		return fmt.Errorf("x: %w %w", io.EOF, os.ErrClosed)
	}
	return errors.Join(io.EOF, os.ErrClosed)
}

func /*@q*/F(n int) error { return errors.Unwrap(src(n)) }

func main() { fmt.Println(F(0), F(1)) }
