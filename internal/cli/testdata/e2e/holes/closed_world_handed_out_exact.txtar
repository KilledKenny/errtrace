package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ Inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.Inner }

type U struct{ inner error }

func (u *U) Error() string { return "u" }
func (u *U) Unwrap() error { return u.inner }

// Set is not called in this package.
func (u *U) Set(e error) { u.inner = e }

type V struct{ inner error }

func (v *V) Error() string { return "v" }
func (v *V) Unwrap() error { return v.inner }

func /*@a*/A(sink func(error)) error {
	var e error = &W{Inner: io.EOF}
	sink(e)
	return errors.Unwrap(e)
}

func /*@b*/B(sink func(error)) error {
	var e error = &U{inner: io.EOF}
	sink(e)
	return errors.Unwrap(e)
}

func /*@c*/C(sink func(error)) error {
	var e error = &V{inner: io.EOF}
	sink(e)
	return errors.Unwrap(e)
}

func /*@r*/R(sink func(error)) error {
	var e error = &W{Inner: io.EOF}
	sink(e)
	return e
}

func main() {
	fmt.Println(A(func(e error) { e.(*W).Inner = os.ErrClosed }))
	fmt.Println(B(func(e error) {}))
	fmt.Println(C(func(e error) {}))
	fmt.Println(R(func(e error) {}))
}
