-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func newW() *W { return &W{inner: io.EOF} }

func mk() W { return W{inner: os.ErrClosed} }

func /*@q*/F() error {
	p := newW()
	*p = mk()
	return errors.Unwrap(p)
}

func main() { fmt.Println(F()) }
