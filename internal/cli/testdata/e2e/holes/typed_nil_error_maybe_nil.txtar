-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import "fmt"

type E struct{}

func (*E) Error() string { return "e" }

func check() error { return nil }

func find(ok bool) (*E, error) {
	if !ok {
		return nil, check()
	}
	return &E{}, nil
}

func /*@t*/T() error {
	e, err := find(false)
	if err != nil {
		return err
	}
	return e
}

func main() { fmt.Println(T() != nil) }
