-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func maybeNil(c bool) error {
	if c {
		return io.EOF
	}
	return nil
}

func /*@q*/F(c bool) error {
	var err error = &W{inner: maybeNil(c)}
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}

func main() { fmt.Println(F(false)) }
