-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import "io"

func each(f func(error)) {
	f(io.ErrUnexpectedEOF)
}

func /*@f*/F(n int) error {
	var err error
	each(func(e error) {
		if n > 0 {
			err = e
			return
		}
		err = io.EOF
	})
	return err
}

func main() {
	_ = F(0)
}
