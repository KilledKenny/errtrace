module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

func src() error { return io.EOF }
func c1() error  { return os.ErrClosed }
func c2() error  { return os.ErrInvalid }

type S struct{ err error }

func (s *S) Err() error { return s.err }

func (s *S) add(e error)  { s.err = errors.Join(s.Err(), e) }
func (s *S) add2(e error) { s.err = fmt.Errorf("%w; %w", s.Err(), e) }
func (s *S) dbl()         { s.err = errors.Join(s.Err(), s.Err()) }

func A(s *S) error { return s.Err() }

func B() (err error) {
	get := func() error { return err }
	defer func() { err = errors.Join(get(), get()) }()
	return src()
}

func /*@q*/C() (err error) {
	get := func() error { return err }
	defer func() { err = errors.Join(get(), c1()) }()
	defer func() { err = errors.Join(get(), c2()) }()
	return src()
}

type T struct{ err error }

func (t *T) Err() error { return t.err }
func (t *T) dbl()       { t.err = errors.Join(t.Err(), t.Err()) }

func D(t *T) error { return t.Err() }

// linked list accumulation
type N struct {
	err  error
	next *N
}

func (n *N) all() error {
	if n == nil {
		return nil
	}
	return errors.Join(n.err, n.next.all())
}

func (n *N) push(e error) *N { return &N{err: fmt.Errorf("n: %w", errors.Join(e, n.all())), next: n} }

func E(n *N) error { return n.all() }

func main() {
	s := &S{}
	s.add(src())
	s.add2(c1())
	s.dbl()
	t := &T{err: io.EOF}
	t.dbl()
	var n *N
	n = n.push(c1()).push(c2())
	fmt.Println(A(s) != nil, B() != nil, C() != nil, D(t) != nil, E(n) != nil)
}
