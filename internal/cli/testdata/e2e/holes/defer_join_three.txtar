-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

func src() error { return io.EOF }
func c1() error  { return os.ErrClosed }
func c2() error  { return os.ErrInvalid }
func c3() error  { return os.ErrExist }

func A() (err error) {
	defer func() { err = errors.Join(err, c1()) }()
	return src()
}

func B() (err error) {
	defer func() { err = errors.Join(err, c1()) }()
	defer func() { err = errors.Join(err, c2()) }()
	return src()
}

func /*@q*/C() (err error) {
	defer func() { err = errors.Join(err, c1()) }()
	defer func() { err = errors.Join(err, c2()) }()
	defer func() { err = errors.Join(err, c3()) }()
	return src()
}

func D() (err error) {
	defer func() {
		if cerr := c1(); cerr != nil {
			err = fmt.Errorf("%w (close: %w)", err, cerr)
		}
	}()
	defer func() {
		if cerr := c2(); cerr != nil {
			err = fmt.Errorf("%w (close: %w)", err, cerr)
		}
	}()
	return src()
}

func main() { fmt.Println(A(), B(), C(), D()) }
