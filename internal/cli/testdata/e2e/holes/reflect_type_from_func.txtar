QA4 C3. Reflection gets the struct type from the function's own type
(Type.In), builds a value and calls the function with it; no value of S
reaches a reflect call and nothing is asserted. A function handed to
reflection exposes the types of its parameters and results.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:11:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:11:35-40: unresolved(memory): field Err of example.com/x.S may be written by reflection, unsafe code or a function that is not seen
	path (origin → target):
		$WORK/a.go:11:35-40: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"reflect"
)

type S struct{ Err error }

func /*@q*/F(s *S) error { return s.Err }

func main() {
	fn := reflect.ValueOf(F)
	v := reflect.New(fn.Type().In(0).Elem())
	v.Elem().Field(0).Set(reflect.ValueOf(&io.EOF).Elem())
	out := fn.Call([]reflect.Value{v})
	fmt.Println(out[0].Interface())
}
