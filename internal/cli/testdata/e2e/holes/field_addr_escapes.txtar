package main

import (
	"errors"
	"io"
)

type S struct{ err error }

var ErrP = errors.New("p")

func setp(p *error) { *p = ErrP }

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	s := &S{err: io.EOF}
	setp(&s.err)
	_ = F(s)
}
