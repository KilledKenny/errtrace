-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

type S struct{ err error }

var ErrMade = errors.New("made")

func make1() S { return S{err: ErrMade} }

// hook is never assigned: the call through it has no Candidates.
var hook func() S

func fill(dst, src *S) {
	*dst = *src
}

func refill(dst *S, n int) {
	if n > 0 {
		*dst = make1()
		return
	}
	*dst = hook()
}

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	src := &S{err: io.EOF}
	dst := new(S)
	fill(dst, src)
	refill(dst, len(io.EOF.Error()))
	_ = F(dst)
}
