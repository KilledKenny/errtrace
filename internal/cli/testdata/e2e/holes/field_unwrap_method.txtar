-- a.go --
package main

import (
	"errors"
	"io"
)

type E struct{ Err error }

func (e *E) Error() string { return "e: " + e.Err.Error() }
func (e *E) Unwrap() error { return e.Err }

var ErrInner = errors.New("inner")

func build(n int) error {
	if n > 0 {
		return &E{Err: ErrInner}
	}
	return &E{Err: io.ErrUnexpectedEOF}
}

func /*@f*/F(n int) error {
	return errors.Unwrap(build(n))
}

func main() {
	_ = F(0)
}
