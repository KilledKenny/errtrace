QA5 M1. A wrapper built as a variable and written field by field is not a
composite literal that errtrace opens: its Wrap holds one Unresolved value.
(Run time: the wrapper holds io.EOF.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:13:12-13: Error Set of example.com/x.T: 2 entries, 1 unresolved
$WORK/a.go:16:9-11: concrete *example.com/x.W
	path (origin → target):
		$WORK/a.go:16:9-11: in example.com/x.T
$WORK/a.go:16:9-11: unresolved(memory): field inner of example.com/x.W: the wrapper is not a tracked value
	wrap chain (origin → target):
		$WORK/a.go:16:9-11: *example.com/x.W.Unwrap
	path (origin → target):
		$WORK/a.go:16:9-11: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func /*@t*/T() error {
	var w W
	w.inner = io.EOF
	return &w
}

func main() { fmt.Println(T()) }
