-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type base struct{ err error }

func (b base) Error() string { return "b" }
func (b base) Unwrap() error { return b.err }

type NotFound base

func (n NotFound) Error() string { return "nf" }
func (n NotFound) Unwrap() error { return base(n).Unwrap() }

func mk() error { return NotFound{err: io.EOF} }

func /*@q*/F() error { return errors.Unwrap(mk()) }

func main() { fmt.Println(F()) }
