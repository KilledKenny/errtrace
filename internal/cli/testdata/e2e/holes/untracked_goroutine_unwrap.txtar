-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
	"sync"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func /*@t*/T() error {
	w := &W{inner: io.EOF}
	var wg sync.WaitGroup
	wg.Add(1)
	go func() {
		defer wg.Done()
		w.inner = os.ErrClosed
	}()
	wg.Wait()
	return w
}

func /*@u*/U() error { return errors.Unwrap(T()) }

func main() { fmt.Println(T(), U()) }
