module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"os"
)

type W struct {
	msg string
	Err error
}

func (w *W) Error() string { return w.msg }
func (w *W) Unwrap() error { return w.Err }

func New(msg string) *W           { return &W{msg: msg} }
func (w *W) WithCause(e error) *W { w.Err = e; return w }

func /*@t*/F() error { return New("x").WithCause(os.ErrClosed) }

func /*@u*/U() error { return errors.Unwrap(F()) }

func main() { fmt.Println(F(), U()) }
