A field that nothing stores to is nil: the load contributes no entry. The
struct is printed with fmt, which only reads it.
-- args --
a.go:@f
-- stdout --
$WORK/a.go:13:12-13: Error Set of example.com/fx.F: 1 entries
$GOROOT/src/io/io.go:*: sentinel io.EOF
	path (origin → target):
		$WORK/a.go:15:10-16: in example.com/fx.F
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type S struct {
	name string
	err  error
}

func /*@f*/F(s *S) error {
	if s.name == "" {
		return io.EOF
	}
	return s.err
}

func main() {
	s := &S{name: "x"}
	fmt.Println(s)
	_ = F(s)
}
