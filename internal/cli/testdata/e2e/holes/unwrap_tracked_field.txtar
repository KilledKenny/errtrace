A field load after a type assertion on a wrapper the analysis followed from
its literal gives the inner value of that very wrapper.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:23:12-13: Error Set of example.com/x.F: 1 entries
$WORK/a.go:14:2-6: sentinel example.com/x.ErrA
	path (origin → target):
		$WORK/a.go:18:35-39: in example.com/x.mkA
		$WORK/a.go:24:14-19: in example.com/x.F, call to example.com/x.mkA
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"io"
)

type E struct{ Err error }

func (e *E) Error() string { return "e" }
func (e *E) Unwrap() error { return e.Err }

var (
	ErrA = errors.New("a")
	ErrB = errors.New("b")
)

func mkA() error { return &E{Err: ErrA} }
func mkB() error { return &E{Err: ErrB} }

var stored *E

func /*@q*/F() error {
	if e, ok := mkA().(*E); ok {
		return e.Err
	}
	return nil
}

func main() {
	stored = &E{Err: io.EOF}
	_, _ = mkB(), F()
}
