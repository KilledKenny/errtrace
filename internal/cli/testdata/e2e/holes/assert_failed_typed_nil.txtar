-- a.go --
package main

import (
	"fmt"
	"io"
)

type E struct{ msg string }

func (e *E) Error() string { return "e" }

func src() error { return io.EOF }

func /*@q*/F() error {
	e, _ := src().(*E)
	return e
}

func main() { fmt.Println(F() != nil) }
