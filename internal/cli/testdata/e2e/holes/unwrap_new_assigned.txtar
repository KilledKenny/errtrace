-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func other() error { return &W{inner: io.EOF} }

func /*@q*/F() error {
	w := new(W)
	w.inner = os.ErrClosed
	return errors.Unwrap(w)
}

func main() { fmt.Println(F(), other()) }
