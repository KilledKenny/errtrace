-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func src(n int) error {
	if n == 0 {
		return io.EOF
	}
	return &W{inner: os.ErrExist}
}

var isW = func(err error) bool { _, ok := err.(*W); return ok }

func /*@q*/F(n int) error {
	err := src(n)
	if isW(err) {
		return errors.Unwrap(err)
	}
	return nil
}

func main() { fmt.Println(F(0), F(1)) }
