-- a.go --
package main

import (
	"errors"
	"fmt"
)

var ErrGet = errors.New("get")

func get(n int) error {
	if n > 0 {
		return ErrGet
	}
	return nil
}

func check(n int) {
	if n > 1 {
		panic("too many")
	}
}

func /*@t*/T(n int) (err error) {
	defer func() { recover() }()
	err = get(n)
	check(n)
	if err != nil {
		return fmt.Errorf("f: %w", err)
	}
	return nil
}

func main() { fmt.Println(T(1), T(2)) }
