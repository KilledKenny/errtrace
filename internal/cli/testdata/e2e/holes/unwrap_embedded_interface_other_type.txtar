module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type A struct{ err error }

func (a *A) Error() string { return "a" }
func (a *A) Unwrap() error { return a.err }

type B struct{ err error }

func (b *B) Error() string { return "b" }
func (b *B) Unwrap() error { return b.err }

func pick(n int) error {
	if n == 0 {
		return &A{err: io.EOF}
	}
	return &B{err: os.ErrClosed}
}

func /*@q*/F() error { return errors.Unwrap(pick(0)) }

func main() { fmt.Println(F(), pick(1)) }
