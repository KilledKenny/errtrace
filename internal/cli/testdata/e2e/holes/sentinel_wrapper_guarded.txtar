-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

var ErrX error = &W{inner: io.EOF}

func src(n int) error {
	if n > 0 {
		return ErrX
	}
	return io.ErrUnexpectedEOF
}

func /*@t*/T(n int) error {
	err := src(n)
	if errors.Is(err, ErrX) {
		return nil
	}
	return err
}

func main() { fmt.Println(T(0), T(1)) }
