-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
)

func src() error { return io.EOF }

func A(n int) error {
	err := src()
	for i := 0; i < n; i++ {
		err = errors.Join(err, err)
	}
	return err
}

func /*@q*/B(n int) (err error) {
	defer func() { err = errors.Join(err, err) }()
	return src()
}

func main() { fmt.Println(A(2), B(1)) }
