-- a.go --
package main

import (
	"fmt"
	"io"
)

func src() error { return fmt.Errorf("x: %w", io.EOF) }

func /*@q*/F() error {
	if u, ok := src().(interface{ Unwrap() error }); ok {
		return u.Unwrap()
	}
	return nil
}

func main() { fmt.Println(F()) }
