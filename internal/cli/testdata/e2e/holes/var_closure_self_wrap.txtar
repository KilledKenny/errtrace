-- a.go --
package main

import (
	"fmt"
	"io"
)

func /*@f*/F(n int) error {
	err := io.EOF
	retry := func() {
		err = fmt.Errorf("retry: %w", err)
	}
	for i := 0; i < n; i++ {
		retry()
	}
	return err
}

func main() {
	_ = F(0)
}
