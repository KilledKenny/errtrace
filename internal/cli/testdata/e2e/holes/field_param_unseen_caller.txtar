package main

import "io"

type S struct{ err error }

func (s *S) set(e error) { s.err = e }

var hook any

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	s := &S{err: io.EOF}
	hook = s.set
	_ = F(s)
}
