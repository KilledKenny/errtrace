package main

import (
	"errors"
	"fmt"
	"io"
)

func closeIt() error { return io.ErrClosedPipe }

func /*@f*/F(n int) (err error) {
	defer func() {
		if cerr := closeIt(); cerr != nil {
			err = fmt.Errorf("close: %w", cerr)
		}
	}()
	if n > 0 {
		return errors.New("early")
	}
	return io.EOF
}

func main() {
	_ = F(0)
}
