QA C1. A *S is converted to an interface with methods and passed down two
functions to reflect.ValueOf, which writes its field. The value at the sink is
traced back through the parameters to the conversion: S is exposed, and the
load keeps an Unresolved entry.
-- args --
a.go:@q
-- stdout --
$WORK/a.go:19:12-13: Error Set of example.com/x.F: 1 entries, 1 unresolved
$WORK/a.go:20:9-14: unresolved(memory): field Err of example.com/x.S may be written by reflection, unsafe code or a function that is not seen
	path (origin → target):
		$WORK/a.go:20:9-14: in example.com/x.F
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"reflect"
)

type S struct{ Err error }

type Loader interface{ Name() string }

func (s *S) Name() string { return "s" }

func poke(v any) { reflect.ValueOf(v).Elem().Field(0).Set(reflect.ValueOf(io.EOF)) }

func load(l Loader) { poke(l) }

func /*@q*/F(s *S) error {
	return s.Err
}

func main() {
	s := &S{}
	load(s)
	fmt.Println(F(s))
}
