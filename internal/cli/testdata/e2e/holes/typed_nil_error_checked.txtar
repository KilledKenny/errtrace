module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type E struct{}

func (*E) Error() string { return "e" }

func find(ok bool) (*E, error) {
	if !ok {
		return nil, io.EOF
	}
	return &E{}, nil
}

func /*@t*/T() error {
	e, err := find(true)
	if err != nil {
		return err
	}
	return e
}

func main() { fmt.Println(T()) }
