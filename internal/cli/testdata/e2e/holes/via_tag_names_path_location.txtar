-- a.go --
package main

import (
	"fmt"
	"io"
)

type A struct{ err error }
type B struct{ err error }

func viaA(a *A) error { return a.err }
func hop1(a *A) error { return viaA(a) }
func hop2(a *A) error { return hop1(a) }
func viaB(b *B) error { return b.err }

func /*@q*/F(a *A, b *B, c bool) error {
	if c {
		return hop2(a)
	}
	return viaB(b)
}

func main() {
	fmt.Println(F(&A{err: io.EOF}, &B{err: io.EOF}, true))
}
