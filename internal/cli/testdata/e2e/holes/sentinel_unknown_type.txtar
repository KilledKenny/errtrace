QA5 M1. A Sentinel that is assigned outside its initialization has a value
whose dynamic type errtrace does not know: it may be a wrapper, which one
Unresolved value says. (Run time: a wrapper that holds os.ErrClosed.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:16:12-13: Error Set of example.com/x.T: 2 entries, 1 unresolved
$WORK/a.go:14:5-9: sentinel example.com/x.ErrU
	path (origin → target):
		$WORK/a.go:18:9-13: in example.com/x.T
$WORK/a.go:14:5-9: unresolved(memory): value of Sentinel main.ErrU may wrap other errors: its dynamic type is not known
	path (origin → target):
		$WORK/a.go:18:9-13: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

var ErrU error = io.EOF

func /*@t*/T() error {
	ErrU = &W{inner: os.ErrClosed}
	return ErrU
}

func main() { fmt.Println(T()) }
