-- a.go --
package main

import (
	"fmt"
	"io"
)

type E struct{ msg string }

func (e *E) Error() string { return "e" }

func src(n int) error {
	if n == 0 {
		return io.EOF
	}
	return &E{msg: "m"}
}

func find(err error) *E {
	e, _ := err.(*E)
	return e
}

func /*@q*/F(n int) error {
	if e := find(src(n)); e != nil {
		return e
	}
	return nil
}

func main() { fmt.Println(F(0), F(1)) }
