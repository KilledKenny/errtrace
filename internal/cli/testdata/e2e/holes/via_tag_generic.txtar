module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
	"os"
)

type G[T any] struct {
	inner error
	v     T
}

func setInt(g *G[int])    { g.inner = io.EOF }
func setStr(g *G[string]) { g.inner = os.ErrClosed }

func /*@q*/F(g *G[string]) error { return g.inner }

func main() {
	a, b := &G[int]{}, &G[string]{}
	setInt(a)
	setStr(b)
	fmt.Println(F(b))
}
