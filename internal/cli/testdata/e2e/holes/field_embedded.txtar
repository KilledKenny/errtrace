package main

import "io"

type base struct{ err error }

type X struct{ base }
type Y struct {
	n int
	base
}

func /*@f*/F(y *Y) error {
	return y.err
}

func main() {
	x := &X{}
	x.err = io.EOF
	y := &Y{base: x.base}
	_ = F(y)
}
