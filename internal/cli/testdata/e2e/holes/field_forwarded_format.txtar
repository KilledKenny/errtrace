-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type S struct{ err error }

func (s *S) failf(format string, args ...any) {
	s.err = fmt.Errorf(format, args...)
}

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	s := new(S)
	s.failf("read: %w", io.EOF)
	s.failf("plain %d", 1)
	_ = F(s)
}
