package main

import (
	"fmt"
	"io"
)

type E struct{}

func (e *E) Error() string { return "e" }

func find(ok bool) *E {
	if ok {
		return &E{}
	}
	return nil
}

func /*@q*/F() error { return find(false) }

func /*@g*/G() error {
	if e := find(false); e != nil {
		return e
	}
	return io.EOF
}

func main() { fmt.Println(F() != nil, G()) }
