module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

func wrap(err error) error { return fmt.Errorf("w: %w", err) }

func /*@q*/F() error { return wrap(io.EOF) }

func main() { fmt.Println(F()) }
