-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type stack struct{ err error }

func (s *stack) push(msg string) {
	s.err = fmt.Errorf("%s: %w", msg, s.err)
}

func /*@f*/F(s *stack) error {
	return s.err
}

func main() {
	s := &stack{err: io.EOF}
	s.push("a")
	s.push("b")
	_ = F(s)
}
