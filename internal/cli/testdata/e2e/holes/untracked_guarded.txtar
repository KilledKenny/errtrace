module example.com/x

go 1.24
-- a.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"os"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func pass(w *W) error { return w }

func /*@t*/T() error {
	err := pass(&W{inner: os.ErrClosed})
	if errors.Is(err, io.EOF) {
		return nil
	}
	return err
}

func main() { fmt.Println(T()) }
