-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type W struct{ a, b error }

func (w *W) Error() string { return "w" }

func (w *W) Unwrap() error {
	if w.a != nil {
		return w.a
	}
	return w.b
}

func pass(w *W) error { return w }

func /*@t*/T() error { return pass(&W{a: io.EOF}) }

func main() { fmt.Println(T()) }
