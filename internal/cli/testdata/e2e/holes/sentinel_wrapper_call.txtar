QA5 M1. A Sentinel of a wrapper type whose initializer is a call: its value
is not a tracked value, and the Wrap that is the Sentinel's value holds one
Unresolved value. (Run time: the wrapper holds io.EOF.)
-- args --
a.go:@t
-- stdout --
$WORK/a.go:17:12-13: Error Set of example.com/x.T: 2 entries, 1 unresolved
$WORK/a.go:15:5-9: sentinel example.com/x.ErrX
	path (origin → target):
		$WORK/a.go:17:31-35: in example.com/x.T
$WORK/a.go:15:5-9: unresolved(memory): field inner of example.com/x.W: the wrapper is not a tracked value
	wrap chain (origin → target):
		$WORK/a.go:15:5-9: *example.com/x.W.Unwrap
	path (origin → target):
		$WORK/a.go:17:31-35: in example.com/x.T
-- go.mod --
module example.com/x

go 1.24
-- a.go --
package main

import (
	"fmt"
	"io"
)

type W struct{ inner error }

func (w *W) Error() string { return "w" }
func (w *W) Unwrap() error { return w.inner }

func newW(e error) *W { return &W{inner: e} }

var ErrX = newW(io.EOF)

func /*@t*/T() error { return ErrX }

func main() { fmt.Println(T()) }
