package main

import "io"

type S struct{ err error }

func run(f func()) { f() }

func /*@f*/F(s *S) error {
	return s.err
}

func main() {
	s := new(S)
	e := io.ErrClosedPipe
	run(func() { s.err = e })
	_ = F(s)
}
