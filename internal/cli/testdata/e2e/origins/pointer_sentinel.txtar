Package-level variables of a concrete error type, returned through an interface, are Sentinels (by identity), not Concrete Types.
-- args --
a.go:@f
-- stdout --
$WORK/a.go:15:12-13: Error Set of example.com/fx.F: 2 entries
$WORK/a.go:11:5-11: sentinel example.com/fx.ErrPtr
	path (origin → target):
		$WORK/a.go:17:10-16: in example.com/fx.F
$WORK/a.go:13:5-11: sentinel example.com/fx.ErrVal
	path (origin → target):
		$WORK/a.go:19:9-15: in example.com/fx.F
-- go.mod --
module example.com/fx

go 1.24
-- a.go --
package fx

type MyErr struct{}

func (*MyErr) Error() string { return "my" }

type ValErr struct{}

func (ValErr) Error() string { return "val" }

var ErrPtr = &MyErr{}

var ErrVal = ValErr{}

func /*@f*/F(b bool) error {
	if b {
		return ErrPtr
	}
	return ErrVal
}
