package fx

type MyErr struct{ Code int }

func (*MyErr) Error() string { return "my" }

type ValErr struct{ Code int }

func (ValErr) Error() string { return "val" }

func /*@f*/F(b bool) error {
	if b {
		return &MyErr{Code: 1}
	}
	return ValErr{Code: 2}
}
