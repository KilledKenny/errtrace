The callgraph-algorithms research toy: an http.HandleFunc closure calling
f(r.Body), f calling r.Read on its io.Reader parameter, apply calling a
callback, and a generic Map calling a function value.
-- go.mod --
module example.com/toy

go 1.24
-- main.go --
package main

import (
	"errors"
	"fmt"
	"io"
	"net/http"
)

var ErrShort = errors.New("short read")

func f(r io.Reader) error {
	buf := make([]byte, 8)
	n, err := r.Read(buf)
	if err != nil {
		return fmt.Errorf("read: %w", err)
	}
	if n < len(buf) {
		return ErrShort
	}
	return nil
}

func apply(cb func() error) error { return cb() }

func Map[T any](xs []T, g func(T) T) []T {
	out := make([]T, 0, len(xs))
	for _, x := range xs {
		out = append(out, g(x))
	}
	return out
}

func main() {
	http.HandleFunc("/", func(w http.ResponseWriter, r *http.Request) {
		if err := f(r.Body); err != nil {
			http.Error(w, err.Error(), http.StatusBadRequest)
		}
	})
	_ = apply(func() error { return ErrShort })
	_ = Map([]int{1, 2}, func(i int) int { return i * 2 })
	_ = http.ListenAndServe("localhost:0", nil)
}
